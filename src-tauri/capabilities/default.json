{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and pop-out panel windows",
  "windows": [
    "main",
    "popout-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "notification:default",
    "store:default"
  ]
}
